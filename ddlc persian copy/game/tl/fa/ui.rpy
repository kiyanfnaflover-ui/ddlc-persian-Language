# RTL Support and Font Management for Persian
init python:
    PERSIAN_FONT = "gui/font/PersianFont.ttf"
    EN_DEFAULT_FONT = "gui/font/Aller_Rg.ttf"
    EN_BUTTON_FONT = "gui/font/RifficFree-Bold.ttf"

    STYLE_CONFIG = [
        ("default", EN_DEFAULT_FONT),
        ("button_text", EN_BUTTON_FONT),
        ("radio_button", EN_BUTTON_FONT),
        ("check_button", EN_BUTTON_FONT),
        ("label_text", EN_DEFAULT_FONT),
        ("slider", EN_DEFAULT_FONT),
        ("mute_all_button", EN_BUTTON_FONT),
        ("game_menu_navigation_button", EN_BUTTON_FONT),
        ("quick_button", EN_DEFAULT_FONT),
        ("history_text", EN_DEFAULT_FONT),
        ("history_name_text", EN_DEFAULT_FONT),
        ("say_dialogue", EN_DEFAULT_FONT),
        ("say_label", EN_DEFAULT_FONT),
        ("input_text", EN_DEFAULT_FONT),
        ("file_picker_text", EN_DEFAULT_FONT),
        ("file_picker_name", EN_DEFAULT_FONT),
        ("file_slot_name_text", EN_DEFAULT_FONT),
        ("file_slot_time_text", EN_DEFAULT_FONT),
        ("notify_text", EN_DEFAULT_FONT),
        ("confirm_prompt_text", EN_DEFAULT_FONT),
        ("centered_text", EN_DEFAULT_FONT),
        ("main_menu_version", EN_DEFAULT_FONT),
    ]

    def apply_lang_styles(lang):
        if lang == "fa":
            for sn, _ in STYLE_CONFIG:
                try:
                    s = getattr(style, sn, None)
                    if s is not None:
                        s.font = PERSIAN_FONT
                        s.text_align = 1.0
                except Exception:
                    pass
        else:
            for sn, ef in STYLE_CONFIG:
                try:
                    s = getattr(style, sn, None)
                    if s is not None:
                        s.font = ef
                        s.text_align = 0.0
                except Exception:
                    pass

    def on_lang_change():
        apply_lang_styles(renpy.game.preferences.language)

    config.change_language_callbacks.append(on_lang_change)

init python:
    apply_lang_styles(None)
